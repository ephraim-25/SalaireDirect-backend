# ============================================
# SalaireDirect Backend - Variables d'environnement
# Copiez ce fichier en .env et renseignez VOS valeurs.
# ⚠️ Ne committez JAMAIS le fichier .env ni de vraies clés.
# ============================================

# Application
NODE_ENV=development
PORT=3000

# Supabase (Project Settings > API)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé « anon » (publique) : utilisée avec le jeton de l'utilisateur, la RLS s'applique
SUPABASE_ANON_KEY=VOTRE_CLE_ANON
# Clé « service_role » (SECRÈTE, contourne la RLS) : uniquement sur le serveur (Render), jamais côté frontend.
# Sert à créer l'entreprise d'un nouveau compte à sa première connexion.
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE

# CORS : origines autorisées, séparées par des virgules (URL du frontend Vercel, sans « / » final)
CORS_ORIGIN=https://salaire-direct-frontend.vercel.app,http://localhost:3001
